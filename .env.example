# Домен должен A/AAAA-записью указывать на этот сервер.
DOMAIN=bitrix.example.com

# Email для уведомлений Let's Encrypt.
CERTBOT_EMAIL=admin@example.com

# Поставить 1 только для проверки выдачи тестового сертификата.
CERTBOT_STAGING=0

# Поставить 1 для принудительной замены существующего сертификата.
CERTBOT_FORCE_RENEWAL=0
